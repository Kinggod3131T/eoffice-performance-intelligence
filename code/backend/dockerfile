FROM golang:1.24-alpine AS builder
RUN apk add --no-cache gcc musl-dev
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=1 go build -o main .
RUN ls -la /app/main  # Debug: verify binary exists

FROM alpine:latest
RUN apk --no-cache add ca-certificates
WORKDIR /app
COPY --from=builder /app/main .
COPY config.json .
RUN chmod +x ./main  # Ensure executable permission
EXPOSE 8080
CMD ["./main"]
